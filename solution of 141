# Definition for singly-linked list.
# class ListNode(object):
#     def __init__(self, x):
#         self.val = x
#         self.next = None

class Solution(object):
    def hasCycle(self, head):
        """
        :type head: ListNode
        :rtype: bool
        """
        b = head
        a = head
        
        while a and a.next:
            b = b.next
            a = a.next.next
            
            if b == a:
                return True
        
        return False    
