class Solution:
    def reverseOnlyLetters(self, s: str) -> str:
        chars = list(s)
        left, right = 0, len(s) - 1
        
        while left < right:
            # Skip non-letters from left
            while left < right and not chars[left].isalpha():
                left += 1
            # Skip non-letters from right
            while left < right and not chars[right].isalpha():
                right -= 1
                
            # If we exited because left >= right, stop
            if left >= right:
                break
                
            # Swap letters
            chars[left], chars[right] = chars[right], chars[left]
            left += 1
            right -= 1
            
        return ''.join(chars)
